{
  "name": "pms",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:api": "pnpm --filter @pms/api start:dev",
    "dev:web": "pnpm --filter @pms/web dev",
    "dev:web:admin": "pnpm --filter @pms/web-admin dev",
    "db:studio": "pnpm --filter @pms/api prisma:studio",
    "db:migrate": "pnpm --filter @pms/api prisma:migrate",
    "db:seed": "pnpm --filter @pms/api prisma:seed",
    "prisma:generate": "prisma generate --schema apps/api/src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema apps/api/src/prisma/schema.prisma",
    "prisma:format": "prisma format --schema apps/api/src/prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema apps/api/src/prisma/schema.prisma -f",
    "prisma:seed": "ts-node -r tsconfig-paths/register apps/api/src/prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/lib-storage": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.896.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^1.10.2",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-fastify": "^10.4.20",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.58.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.8.0",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pino": "^9.11.0",
    "pino-pretty": "^11.3.0",
    "puppeteer": "^24.22.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.17",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "5.22.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register apps/api/src/prisma/seed.ts"
  }
}
